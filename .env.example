# Environment variables example
# OpenAI for scene generation
OPENAI_API_KEY=your_openai_api_key_here
# ElevenLabs for TTS
ELEVENLABS_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
# OmniRoute (if you want to send scenes)
OMNIROUTE_URL=https://api.omniroute.example
OMNIROUTE_KEY=your_omniroute_key_here
